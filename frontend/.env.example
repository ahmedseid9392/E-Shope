# Supabase (get these from your Supabase project settings, or `supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server-only — never expose to the client

# Chapa (Ethiopian payment gateway)
CHAPA_SECRET_KEY=                # server-only — from your Chapa dashboard (test or live key)
CHAPA_WEBHOOK_SECRET=            # optional — only needed if you add a webhook in the Chapa dashboard (Settings → Webhooks). Payments work without it.

# Email (transactional — welcome, admin login OTP, order confirmation/status; password reset is sent by Supabase itself)
# Sent via Gmail SMTP (nodemailer). Requires 2-Step Verification on the Gmail
# account, then an App Password from https://myaccount.google.com/apppasswords
GMAIL_USER=                      # the full @gmail.com address you're sending from
GMAIL_APP_PASSWORD=              # 16-character App Password (not your normal Gmail password)
EMAIL_FROM=E-Shope <you@gmail.com>   # optional display name/from — defaults to GMAIL_USER if unset

# Cloudinary (product + profile image uploads — unsigned client-side upload)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=   # create as "Unsigned" in Cloudinary dashboard

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
