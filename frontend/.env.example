# Supabase (get these from your Supabase project settings, or `supabase status` locally)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server-only — never expose to the client

# Chapa (Ethiopian payment gateway)
CHAPA_SECRET_KEY=                # server-only — from your Chapa dashboard (test or live key)
CHAPA_WEBHOOK_SECRET=            # optional — only needed if you add a webhook in the Chapa dashboard (Settings → Webhooks). Payments work without it.

# Email (transactional — welcome, admin login OTP, order confirmation/status, password reset)
RESEND_API_KEY=                  # from your Resend dashboard — used for everything except password reset
EMAIL_FROM=E-Shope <onboarding@resend.dev>   # must be a verified sender/domain in Resend once you're past their sandbox address

# Cloudinary (product + profile image uploads — unsigned client-side upload)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=   # create as "Unsigned" in Cloudinary dashboard

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
